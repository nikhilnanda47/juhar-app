{
  "name": "juhar-app",
  "version": "1.0.0",
  "private": true,
  "description": "Juhar — D2C Sambalpuri fashion e-commerce platform",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/admin",
    "apps/web"
  ],
  "scripts": {
    "postinstall": "npm run build -w packages/shared",
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:mobile": "npm run dev -w apps/mobile",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "lint": "eslint . --max-warnings 20",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:seed:demo": "npm run db:seed:demo -w apps/api --",
    "db:studio": "npm run db:studio -w apps/api",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.74.0"
  }
}
