# Database
DATABASE_URL="postgresql://juhar:juhar_dev_password@localhost:5432/juhar_dev?schema=public"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"

# Server
PORT=3000
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:8081"
NODE_ENV=development
# Number of proxies in front of the API (for example 1 on Railway). Leave unset for local development.
# Needed so the rate limits see each caller's real IP address instead of the proxy's.
# TRUST_PROXY=1

# How much the API logs: error, warn, log (default), debug or verbose. Each level includes the ones before it.
# LOG_LEVEL=log

# OTP provider. "mock" accepts the fixed code 123456 for every phone number: development only.
# The API refuses to start with NODE_ENV=production while this is "mock" or unset, unless it is a CLOSED PILOT:
# list the only phone numbers allowed to sign in below. Every other number is refused (including on verify and refresh).
# A real SMS provider is added to the supported values when it is built; the list is then not used.
OTP_PROVIDER=mock
# Closed pilot: the team's numbers as +91 and ten digits, separated by commas, no spaces inside a number.
# Include the admin's number or the admin cannot sign in. Leave unset for local development (everyone may sign in).
# MOCK_OTP_ALLOWED_PHONES=+919876543210,+919123456789
# OTP_API_KEY=

# Payment Gateway (placeholder)
PAYMENT_GATEWAY=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# S3 / Object Storage (placeholder)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_BASE_URL=
