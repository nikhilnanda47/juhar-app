# Database
# On Supabase there are two addresses (Project Settings > Database > Connection string):
#  - DATABASE_URL: the TRANSACTION POOLER (port 6543). It needs ?pgbouncer=true on the end; a live API refuses to start without it.
#  - DIRECT_URL: the DIRECT connection (port 5432). Only the release step that applies migrations uses it
#    (`npm run db:migrate:deploy`). Leave it unset on a plain local Postgres.
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
DATABASE_URL="postgresql://juhar:juhar_dev_password@localhost:5432/juhar_dev?schema=public"

# JWT
# A live API (NODE_ENV=production) refuses to start unless both secrets are at least 32 random characters and different.
# Make each one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"

# Server
# Railway sets PORT itself. CORS_ORIGINS REPLACES the built-in local list: on a live API list the website and admin addresses.
PORT=3000
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:8081"
NODE_ENV=development
# Number of proxies in front of the API (for example 1 on Railway). Leave unset for local development.
# Needed so the rate limits see each caller's real IP address instead of the proxy's.
# TRUST_PROXY=1

# How much the API logs: error, warn, log (default), debug or verbose. Each level includes the ones before it.
# LOG_LEVEL=log

# The API's Swagger page (/api/docs) is off when NODE_ENV=production. Turn it on only if you need it there.
# ENABLE_API_DOCS=true

# OTP provider. "mock" accepts the fixed code 123456 for every phone number: development only.
# The API refuses to start with NODE_ENV=production while this is "mock" or unset, unless it is a CLOSED PILOT:
# list the only phone numbers allowed to sign in below. Every other number is refused (including on verify and refresh).
# A real SMS provider is added to the supported values when it is built; the list is then not used.
OTP_PROVIDER=mock
# Closed pilot: the team's numbers as +91 and ten digits, separated by commas, no spaces inside a number.
# Include the admin's number or the admin cannot sign in. Leave unset for local development (everyone may sign in).
# MOCK_OTP_ALLOWED_PHONES=+919876543210,+919123456789
# OTP_API_KEY=

# Payment Gateway (placeholder)
PAYMENT_GATEWAY=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Product photos.
# Development: leave all of this unset. Photos are shrunk and kept in apps/api/uploads (UPLOAD_DIR to change it) and the
# API serves them itself at http://localhost:3000/media.
# Live: use a Cloudflare R2 bucket. A live server's own disk is wiped on every deploy, so with nothing set below the API
# starts but REFUSES photo uploads (and says why). Set all five or none (a half-filled set stops the start):
#   R2_ACCOUNT_ID         Cloudflare dashboard > R2 > Account ID
#   R2_ACCESS_KEY_ID      R2 > Manage API tokens > create a token with "Object Read & Write" for this bucket
#   R2_SECRET_ACCESS_KEY  (shown once when the token is created)
#   R2_BUCKET             the bucket's name
#   MEDIA_PUBLIC_URL      where the bucket is public, https, no trailing slash: the bucket's "Public Development URL"
#                         (https://pub-xxxx.r2.dev) or, better, a custom domain such as https://photos.juhar.co.in
# UPLOAD_DIR=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# MEDIA_PUBLIC_URL=
