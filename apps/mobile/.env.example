# The server the app talks to. Optional for local development: when unset, the app uses http://localhost:3000.
# Copy this file to .env to point the browser preview or a local build at another server, for example the pilot:
#   EXPO_PUBLIC_API_URL=https://your-pilot-api.example.com
# Release builds (EAS) take it from the profile in eas.json, and refuse to run without a real https address.
# EXPO_PUBLIC_API_URL=
