{
  "expo": {
    "name": "Juhar",
    "slug": "juhar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "juhar",
    "splash": {
      "backgroundColor": "#FAFAF7",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.juhar.app"
    },
    "android": {
      "package": "com.juhar.app",
      "adaptiveIcon": {
        "backgroundColor": "#8B3A4A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
